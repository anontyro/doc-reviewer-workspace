{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLM Review Workspace",
  "version": "0.0.0",
  "identifier": "local.llm-review-workspace",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "LLM Review Workspace", "width": 1200, "height": 800 }],
    "security": { "csp": "default-src 'self'; style-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
