{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DomainSchemas",
  "description": "Root used only to emit one schema holding every entity under `$defs`. Never serialised.",
  "type": "object",
  "properties": {
    "annotation": {
      "$ref": "#/$defs/Annotation"
    },
    "annotation_file": {
      "$ref": "#/$defs/AnnotationFile"
    },
    "document": {
      "$ref": "#/$defs/Document"
    },
    "document_version": {
      "$ref": "#/$defs/DocumentVersion"
    },
    "draft_file": {
      "$ref": "#/$defs/DraftFile"
    },
    "export_snapshot": {
      "$ref": "#/$defs/ExportSnapshot"
    },
    "library_file": {
      "$ref": "#/$defs/LibraryFile"
    },
    "project_file": {
      "$ref": "#/$defs/ProjectFile"
    },
    "review_round": {
      "$ref": "#/$defs/ReviewRound"
    }
  },
  "required": [
    "project_file",
    "document",
    "document_version",
    "review_round",
    "annotation",
    "export_snapshot",
    "library_file",
    "draft_file",
    "annotation_file"
  ],
  "$defs": {
    "Anchor": {
      "type": "object",
      "properties": {
        "confidence": {
          "$ref": "#/$defs/AnchorConfidence"
        },
        "exact": {
          "description": "The exact selected passage, verbatim.",
          "type": "string"
        },
        "heading_path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prefix": {
          "type": "string"
        },
        "source_hash": {
          "description": "sha256 (hex) of the document version the anchor was made against.",
          "type": "string"
        },
        "source_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "suffix": {
          "type": "string"
        }
      },
      "required": [
        "exact",
        "prefix",
        "suffix",
        "heading_path",
        "source_hash",
        "confidence"
      ]
    },
    "AnchorConfidence": {
      "description": "How sure the app is that an anchor still points at the intended passage (PRD §6.3).\nRecommended values, not confirmed scope (decision 0002).",
      "type": "string",
      "enum": [
        "resolved",
        "ambiguous",
        "orphaned"
      ]
    },
    "Annotation": {
      "type": "object",
      "properties": {
        "action_type": {
          "$ref": "#/$defs/AnnotationAction"
        },
        "anchor": {
          "$ref": "#/$defs/Anchor"
        },
        "created_at": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/AnnotationId"
        },
        "replacement_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "round_id": {
          "$ref": "#/$defs/RoundId"
        },
        "schema_version": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AnnotationStatus"
        },
        "text": {
          "description": "The user's comment, stored and exported verbatim.",
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "id",
        "round_id",
        "action_type",
        "text",
        "anchor",
        "status",
        "created_at",
        "updated_at"
      ]
    },
    "AnnotationAction": {
      "description": "Recommended values (PRD §6.2), not confirmed scope (decision 0002).",
      "type": "string",
      "enum": [
        "comment",
        "replace",
        "remove",
        "expand",
        "question",
        "approve"
      ]
    },
    "AnnotationFile": {
      "description": "The one file that holds every comment on a document (F2 spec D15). F3 may replace it with project storage.",
      "type": "object",
      "properties": {
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Annotation"
          }
        },
        "document_id": {
          "$ref": "#/$defs/DocumentId"
        },
        "next_sequence": {
          "description": "Next `rev_NNNN` sequence number. It only grows, so a deleted id is never reused (F2 spec D17).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "path": {
          "description": "Path the document had when last saved. Informational only: identity is `document_id`.",
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "document_id",
        "path",
        "next_sequence",
        "annotations"
      ]
    },
    "AnnotationId": {
      "type": "string",
      "pattern": "^rev_.+$"
    },
    "AnnotationStatus": {
      "description": "Recommended values (PRD §6.2). Export inclusion is not a status.",
      "type": "string",
      "enum": [
        "open",
        "resolved",
        "superseded"
      ]
    },
    "Document": {
      "type": "object",
      "properties": {
        "active_version_id": {
          "$ref": "#/$defs/VersionId"
        },
        "format": {
          "$ref": "#/$defs/DocumentFormat"
        },
        "id": {
          "$ref": "#/$defs/DocumentId"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "relative_path": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "id",
        "project_id",
        "relative_path",
        "format",
        "active_version_id"
      ]
    },
    "DocumentFormat": {
      "type": "string",
      "enum": [
        "markdown",
        "pdf"
      ]
    },
    "DocumentId": {
      "type": "string",
      "pattern": "^doc_.+$"
    },
    "DocumentVersion": {
      "type": "object",
      "properties": {
        "content_hash": {
          "description": "sha256 (hex) of the snapshot bytes.",
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "document_id": {
          "$ref": "#/$defs/DocumentId"
        },
        "id": {
          "$ref": "#/$defs/VersionId"
        },
        "origin": {
          "description": "Free text until F4 (T-011) defines the values. The PRD names the field but not its values.",
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "snapshot_path": {
          "type": "string"
        },
        "version_number": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "schema_version",
        "id",
        "document_id",
        "version_number",
        "content_hash",
        "snapshot_path",
        "created_at",
        "origin"
      ]
    },
    "DraftFile": {
      "description": "Unsaved editor text, written so a crash does not lose it. `base_hash` is the hash of the file the text was\nedited from, so restoring it can still detect a file that changed since.",
      "type": "object",
      "properties": {
        "base_hash": {
          "type": "string"
        },
        "document_id": {
          "$ref": "#/$defs/DocumentId"
        },
        "saved_at": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "document_id",
        "base_hash",
        "text",
        "saved_at"
      ]
    },
    "ExportId": {
      "type": "string",
      "pattern": "^exp_.+$"
    },
    "ExportSnapshot": {
      "type": "object",
      "properties": {
        "annotation_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnnotationId"
          }
        },
        "created_at": {
          "type": "string"
        },
        "document_version_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VersionId"
          }
        },
        "format": {
          "description": "Free text until F4 (T-012/T-013): copied prompt or review package.",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/ExportId"
        },
        "payload_hash": {
          "type": "string"
        },
        "relative_output_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema_version": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "id",
        "created_at",
        "format",
        "document_version_refs",
        "annotation_ids",
        "payload_hash"
      ]
    },
    "LibraryFile": {
      "description": "`<app data>/library.json`. Rebuildable by opening the folders again.",
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LibraryRecord"
          }
        },
        "schema_version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "entries"
      ]
    },
    "LibraryRecord": {
      "description": "One remembered project. A cache of what the user opened: `project.json` wins if the name differs.",
      "type": "object",
      "properties": {
        "last_opened_at": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "root_path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "project_id",
        "name",
        "root_path",
        "last_opened_at"
      ]
    },
    "ProjectDocument": {
      "description": "A document the user added to a project. Only added documents are tracked, the folder is never scanned.",
      "type": "object",
      "properties": {
        "added_at": {
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/DocumentFormat"
        },
        "relative_path": {
          "description": "A single file name in the project root (F3 spec D9). Never an absolute path.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "relative_path",
        "format",
        "added_at"
      ]
    },
    "ProjectFile": {
      "description": "`<project>/.review-workspace/project.json`. Holds no absolute path, so the folder can be moved or synced.",
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string"
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectDocument"
          }
        },
        "id": {
          "$ref": "#/$defs/ProjectId"
        },
        "name": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "name",
        "created_at",
        "updated_at",
        "documents"
      ]
    },
    "ProjectId": {
      "type": "string",
      "pattern": "^proj_.+$"
    },
    "ReviewRound": {
      "type": "object",
      "properties": {
        "completed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "string"
        },
        "document_version_id": {
          "$ref": "#/$defs/VersionId"
        },
        "id": {
          "$ref": "#/$defs/RoundId"
        },
        "schema_version": {
          "type": "string"
        },
        "state": {
          "description": "Free text until F4 (T-011) defines the values. The PRD names the field but not its values.",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "id",
        "document_version_id",
        "state",
        "created_at"
      ]
    },
    "RoundId": {
      "type": "string",
      "pattern": "^rnd_.+$"
    },
    "SourceRange": {
      "description": "Derived helper, never the sole identity of a target. Units are fixed by decision 0005 after the F1 spike.",
      "type": "object",
      "properties": {
        "end": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "start": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "VersionId": {
      "type": "string",
      "pattern": "^ver_.+$"
    }
  }
}
